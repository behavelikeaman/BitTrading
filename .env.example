# Deepcoin — 실시간 시세·펀딩 조회 전용.
# 주의: 거래·출금 권한이 없는 READ-ONLY 키만 사용할 것. v1은 주문을 넣지 않는다.
DEEPCOIN_API_KEY=
DEEPCOIN_API_SECRET=
# 패스프레이즈 = 키를 만들 때 Password 칸에 넣은 값. 발급되는 값이 아니고
# 기존 키에 나중에 추가할 수 없다. 잊었으면 키를 새로 만들어야 한다.
#
# 주의: 값에 $ 가 들어 있으면 반드시 역슬래시로 escape 하라.
#   Next.js(@next/env)가 $부터를 환경변수 이름으로 보고 치환해버린다.
#   없는 변수면 빈 문자열이 되어 $ 앞부분만 남는다 — 조용히 잘린다.
#
#   실측(@next/env로 확인):
#     ab$cdef1     -> "ab"        (잘림)
#     'ab$cdef1'   -> "ab"        (작은따옴표도 소용없다)
#     "ab$cdef1"   -> "ab"        (큰따옴표도 소용없다)
#     ab\$cdef1    -> "ab$cdef1"  (역슬래시만 통한다)
#
#   # 는 주석 시작이라 뒤가 잘린다. 이쪽은 따옴표로 감싸면 된다.
#
# 특수문자 없는 비밀번호를 쓰면 이 문제 자체가 없다.
DEEPCOIN_API_PASSPHRASE=

# Anthropic — 레짐 해설·매매 저널 생성용
ANTHROPIC_API_KEY=

# Binance 과거 캔들은 공개 엔드포인트라 키가 필요 없다.
